# Server
HOST=0.0.0.0
PORT=1337

# Secrets (generar valores propios en producción, nunca reusar los del repo)
APP_KEYS=changeme1,changeme2,changeme3,changeme4
API_TOKEN_SALT=changeme
ADMIN_JWT_SECRET=changeme
JWT_SECRET=changeme
TRANSFER_TOKEN_SALT=changeme
ENCRYPTION_KEY=changeme

# Database — desarrollo local rápido con SQLite:
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Database — Postgres (staging/producción). Comentar el bloque de arriba y
# descomentar este, o simplemente sobreescribir DATABASE_CLIENT=postgres
# en el .env del hosting (Render/Heroku/VM):
# DATABASE_CLIENT=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=claroscuro
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=strapi
# DATABASE_SSL=false
