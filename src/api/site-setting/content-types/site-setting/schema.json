{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Site Settings",
    "description": "Configuración global del sitio: logo, contacto, hero"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "business_name": {
      "type": "string",
      "required": true
    },
    "whatsapp": {
      "type": "string",
      "required": true
    },
    "instagram": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "hero_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "tagline": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
